{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "sixel",
        "source": "~/.config/fastfetch/assets/selected-anime-girl-fastfetch.jpg",
        "width": 36,
        "height": 16,
        "preserveAspectRatio": false,
        "printRemaining": false,
        "padding": {
            "top": 2,
            "left": 3,
            "right": 3
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "magenta",
            "separator": "cyan",
            "output": "white"
        },
        "bar": {
            "width": 12,
            "char": {
                "elapsed": "━",
                "total": "─"
            }
        }
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "{#35}╭─ {#36}niri candybox {#35}────────────────────────╮"
        },
        {
            "type": "os",
            "key": "{#35}│ {#36}OS      "
        },
        {
            "type": "kernel",
            "key": "{#35}│ {#36}KERNEL  "
        },
        {
            "type": "packages",
            "key": "{#35}│ {#36}PKGS    "
        },
        {
            "type": "shell",
            "key": "{#35}│ {#36}SHELL   "
        },
        {
            "type": "wm",
            "key": "{#35}│ {#36}WM      "
        },
        {
            "type": "icons",
            "key": "{#35}│ {#36}ICONS   "
        },
        {
            "type": "cursor",
            "key": "{#35}│ {#36}CURSOR  "
        },
        {
            "type": "terminal",
            "key": "{#35}│ {#36}TERM    "
        },
        {
            "type": "terminalfont",
            "key": "{#35}│ {#36}FONT    "
        },
        {
            "type": "custom",
            "format": "{#35}├─ {#36}hardware {#35}─────────────────────────────┤"
        },
        {
            "type": "cpu",
            "key": "{#35}│ {#36}CPU     ",
            "format": "{1} ({3})"
        },
        {
            "type": "gpu",
            "key": "{#35}│ {#36}GPU     ",
            "format": "{1} {2}"
        },
        {
            "type": "memory",
            "key": "{#35}│ {#36}MEM     "
        },
        {
            "type": "disk",
            "key": "{#35}│ {#36}DISK    "
        },
        {
            "type": "custom",
            "format": "{#35}╰─────────────────────────────────────────────╯"
        }
    ]
}
