#
# Universal GRUB defaults managed by scripts/install-grub.sh.
# Host-specific kernel arguments belong in the live /etc/default/grub
# or host profiles, not in this shared template.
#
GRUB_TIMEOUT=5
GRUB_DISTRIBUTOR="Void"
GRUB_CMDLINE_LINUX_DEFAULT="quiet loglevel=3 udev.log_level=3 vt.global_cursor_default=0"
GRUB_GFXMODE="auto"
GRUB_THEME="/boot/grub/themes/MilkGrub/theme.txt"
GRUB_DISABLE_SUBMENU=true
