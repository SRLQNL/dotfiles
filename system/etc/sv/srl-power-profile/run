#!/bin/sh
exec 2>&1

CONFIG_FILE=${SRL_POWER_PROFILE_CONFIG:-/etc/sv/srl-power-profile/conf}
[ -r "$CONFIG_FILE" ] && . "$CONFIG_FILE"

CPU_GOVERNOR=${CPU_GOVERNOR:-powersave}
CPU_EPP=${CPU_EPP:-balance_performance}
CPU_NO_TURBO=${CPU_NO_TURBO:-0}
CPU_MIN_PERF_PCT=${CPU_MIN_PERF_PCT:-15}
CPU_MAX_PERF_PCT=${CPU_MAX_PERF_PCT:-100}
GPU_POWER_LIMIT=${GPU_POWER_LIMIT:-}
GPU_PERSISTENCE_MODE=${GPU_PERSISTENCE_MODE:-1}

write_if_supported() {
    file=$1
    value=$2

    [ -w "$file" ] || return 0

    if [ "${file##*/}" = "scaling_governor" ] && [ -r "${file%/*}/scaling_available_governors" ]; then
        grep -qw -- "$value" "${file%/*}/scaling_available_governors" || return 0
    fi

    if [ "${file##*/}" = "energy_performance_preference" ] && [ -r "${file%/*}/energy_performance_available_preferences" ]; then
        grep -qw -- "$value" "${file%/*}/energy_performance_available_preferences" || return 0
    fi

    printf '%s\n' "$value" > "$file" || true
}

apply_cpu_profile() {
    if [ -n "$CPU_NO_TURBO" ]; then
        if [ -w /sys/devices/system/cpu/intel_pstate/no_turbo ]; then
            # Intel pstate: 1=disable turbo, 0=enable turbo
            write_if_supported /sys/devices/system/cpu/intel_pstate/no_turbo "$CPU_NO_TURBO"
        elif [ -w /sys/devices/system/cpu/cpufreq/boost ]; then
            # AMD cpufreq: 0=disable turbo, 1=enable turbo (inverted)
            if [ "$CPU_NO_TURBO" = "1" ]; then
                write_if_supported /sys/devices/system/cpu/cpufreq/boost 0
            else
                write_if_supported /sys/devices/system/cpu/cpufreq/boost 1
            fi
        fi
    fi

    if [ -w /sys/devices/system/cpu/intel_pstate/min_perf_pct ]; then
        [ -n "$CPU_MIN_PERF_PCT" ] &&
            write_if_supported /sys/devices/system/cpu/intel_pstate/min_perf_pct "$CPU_MIN_PERF_PCT"
        [ -n "$CPU_MAX_PERF_PCT" ] &&
            write_if_supported /sys/devices/system/cpu/intel_pstate/max_perf_pct "$CPU_MAX_PERF_PCT"
    fi

    for governor in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
        [ -e "$governor" ] || continue
        [ -n "$CPU_GOVERNOR" ] || continue
        write_if_supported "$governor" "$CPU_GOVERNOR"
    done

    for epp in /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do
        [ -e "$epp" ] || continue
        [ -n "$CPU_EPP" ] || continue
        write_if_supported "$epp" "$CPU_EPP"
    done
}

apply_nvidia_profile() {
    nvidia_smi=$(command -v nvidia-smi) || return 0

    i=0
    while [ "$i" -lt 30 ]; do
        if "$nvidia_smi" >/dev/null 2>&1; then
            [ -n "$GPU_PERSISTENCE_MODE" ] &&
                "$nvidia_smi" -pm "$GPU_PERSISTENCE_MODE" >/dev/null 2>&1 || true
            [ -n "$GPU_POWER_LIMIT" ] &&
                "$nvidia_smi" -pl "$GPU_POWER_LIMIT" >/dev/null 2>&1 || true
            return 0
        fi

        i=$((i + 1))
        sleep 1
    done
}

apply_cpu_profile
apply_nvidia_profile

exec sleep infinity
