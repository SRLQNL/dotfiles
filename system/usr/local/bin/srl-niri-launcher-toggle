#!/bin/sh
set -eu

USER_NAME=${NIRI_USER:-srl}
USER_ID=${NIRI_UID:-1000}
RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$USER_ID}

socket=$(
    find "$RUNTIME_DIR" -maxdepth 1 -type s -name 'niri.*.sock' -printf '%T@ %p\n' 2>/dev/null |
        sort -nr |
        awk 'NR == 1 { print $2 }'
)

[ -n "$socket" ] || exit 0

if [ "$(id -u)" -eq "$USER_ID" ]; then
    exec env \
        XDG_RUNTIME_DIR="$RUNTIME_DIR" \
        NIRI_SOCKET="$socket" \
        /usr/bin/niri msg action spawn-sh -- \
        'pkill -x wofi || /usr/bin/wofi --show drun'
else
    exec /usr/bin/chpst -u "$USER_NAME" env \
        XDG_RUNTIME_DIR="$RUNTIME_DIR" \
        NIRI_SOCKET="$socket" \
        /usr/bin/niri msg action spawn-sh -- \
        'pkill -x wofi || /usr/bin/wofi --show drun'
fi
