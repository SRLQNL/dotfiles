#!/bin/sh
exec 2>&1
# Wait for SMBus adapter to appear (needed for RAM RGB, not monitor DDC/CI i2c buses)
for i in $(seq 1 15); do
    grep -ql 'smbus\|SMBus' /sys/bus/i2c/devices/*/name 2>/dev/null && break
    sleep 1
done
openrgb --noautoconnect --device 0 --mode Off >/dev/null 2>&1 || true
openrgb --noautoconnect --device 1 --mode Off >/dev/null 2>&1 || true
exec sleep infinity
