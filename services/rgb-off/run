#!/bin/sh
exec 2>&1
# Wait for any i2c device to appear (bus number varies by hardware)
for i in $(seq 1 10); do
    ls /dev/i2c-* >/dev/null 2>&1 && break
    sleep 1
done
openrgb --noautoconnect --device 0 --mode Off >/dev/null 2>&1 || true
openrgb --noautoconnect --device 1 --mode Off >/dev/null 2>&1 || true
exec sleep infinity
