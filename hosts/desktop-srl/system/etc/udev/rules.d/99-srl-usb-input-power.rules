# Keep the desktop USB input path awake across boot.
#
# desktop-srl has the keyboard and mouse behind USB hubs:
# - 258a:010c BY Tech Gaming Keyboard
# - 046d:c08b Logitech G502 HERO Gaming Mouse
#
# usbcore.autosuspend=-1 is set in kernel cmdline (handles boot-time enumeration).
# This rule handles runtime: ensures hubs and devices stay on after boot settles.

ACTION!="add", SUBSYSTEM!="usb", GOTO="srl_usb_input_power_end"

# USB hubs — disable autosuspend completely.
ACTION=="add", SUBSYSTEM=="usb", ATTR{bDeviceClass}=="09", \
  ATTR{power/control}="on", \
  ATTR{power/autosuspend_delay_ms}="0"

# Keyboard and mouse.
ACTION=="add", SUBSYSTEM=="usb", \
  ATTR{idVendor}=="258a", ATTR{idProduct}=="010c", \
  ATTR{power/control}="on"
ACTION=="add", SUBSYSTEM=="usb", \
  ATTR{idVendor}=="046d", ATTR{idProduct}=="c08b", \
  ATTR{power/control}="on"

LABEL="srl_usb_input_power_end"
