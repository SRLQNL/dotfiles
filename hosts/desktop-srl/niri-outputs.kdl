// Host-specific niri output configuration for desktop-srl
// Two DP monitors stacked vertically: DP-2 is the primary bottom output, DP-1 is top.

output "DP-2" {
    mode "1920x1080@143.981"
    scale 1
    transform "normal"
    position x=0 y=1080
    // VRR on-demand: active only when a window requests it (games/video)
    // Always-on VRR has cursor lag and flash bugs on NVIDIA; on-demand is safe
    variable-refresh-rate on-demand=true
    hot-corners {
        off
    }
}

output "DP-1" {
    mode "1920x1080@143.981"
    scale 1
    transform "normal"
    position x=0 y=0
    variable-refresh-rate on-demand=true
    hot-corners {
        off
    }
}
