# Host: desktop-srl
# Hardware: NVIDIA RTX 3070 Ti, dual 1920x1080@144Hz DP monitors
PROFILES="desktop-nvidia steam grub-themed power-profile rgb"

# Monitor names (niri: run 'niri msg outputs' to see current names)
NIRI_PRIMARY_OUTPUT="DP-2"
NIRI_SECONDARY_OUTPUT="DP-1"
NIRI_PRIMARY_MODE="1920x1080@143.981"
NIRI_SECONDARY_MODE="1920x1080@143.981"
NIRI_PRIMARY_POSITION="0,1080"
NIRI_SECONDARY_POSITION="0,0"

# Lock screen output names (used by one-screen-lock if present)
LOCK_TOP_OUTPUT="DP-1"
LOCK_BOTTOM_OUTPUT="DP-2"

# GPU power cap (W); must match what nvidia-smi accepts for this card
GPU_POWER_LIMIT=275

# Keep USB keyboard/mouse path powered during boot.
INSTALL_USB_INPUT_POWER_FIX=1

# Host-specific network/security policy.
INSTALL_NFTABLES_CONFIG=1
INSTALL_SSH_HARDENING=1

# GRUB resolution (must be supported by the firmware)
GRUB_GFXMODE="1920x1080x32,auto"

# IOMMU — DMA attack protection (Intel CPU)
GRUB_EXTRA_CMDLINE="${GRUB_EXTRA_CMDLINE:+${GRUB_EXTRA_CMDLINE} }intel_iommu=on iommu=pt"

# Steam storage paths (on separate drive)
STEAM_DATA_DIR="/adata/Steam"
STEAM_LIBRARY_DIR="/adata/SteamLibrary"

# Screenshot output directory
SCREENSHOT_DIR="/storage/Screenshots"

# CPU power profile (used by power-profile runit service)
CPU_GOVERNOR="performance"
CPU_EPP="balance_performance"

# Proxy service name (runit service in /etc/sv/)
PROXY_SV_NAME="naive-proxy"
# SOCKS5 proxy address for IP check
PROXY_SOCKS5="127.0.0.1:1080"
