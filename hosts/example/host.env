# Example host config — copy to hosts/<your-hostname>/host.env and edit
#
# Quick steps for a new machine:
#   1. Find your hostname:        hostname -s
#   2. Copy this template:        cp hosts/example/host.env hosts/$(hostname -s)/host.env
#   3. Edit the copy, then run:   ./install.sh
#   4. List niri outputs:         niri msg outputs   (run after first boot into niri)
#   5. List available GRUB modes: press 'c' in GRUB, then run: videoinfo

# ── Profiles ─────────────────────────────────────────────────────────────────
# Activate features by adding profile names here (space-separated).
# Available profiles:
#   desktop-nvidia  — NVIDIA proprietary driver, kernel params, power limit
#   laptop          — battery management, TLP, touchpad extras
#   steam           — Steam + Proton + gamemode
#   grub-themed     — MilkGrub theme + custom resolution
#   power-profile   — CPU/GPU power management runit service
#   rgb             — OpenRGB, turns off RGB on boot
PROFILES=""
# Example (NVIDIA gaming desktop): PROFILES="desktop-nvidia steam grub-themed power-profile"
# Example (laptop):                PROFILES="laptop"

# ── Monitor / niri output config ─────────────────────────────────────────────
# Run 'niri msg outputs' inside a running niri session to find connector names.
# Single-monitor desktop/laptop example: only set PRIMARY, leave SECONDARY empty.
# Dual-monitor example: PRIMARY = lower/main monitor, SECONDARY = upper/second.
NIRI_PRIMARY_OUTPUT="eDP-1"
NIRI_SECONDARY_OUTPUT=""
# Mode format: WIDTHxHEIGHT@REFRESH  (e.g. "1920x1080@60" or "2560x1440@144")
NIRI_PRIMARY_MODE="1920x1080@60"
NIRI_SECONDARY_MODE=""
# Position in virtual screen space (x,y in pixels from top-left).
# Single monitor: "0,0".  Dual vertical stack: bottom="0,1080", top="0,0".
NIRI_PRIMARY_POSITION="0,0"
NIRI_SECONDARY_POSITION=""

# ── Lock screen outputs ───────────────────────────────────────────────────────
# Output names used by the lock script (swaylock/one-screen-lock).
# For single-monitor setups, set LOCK_TOP_OUTPUT = NIRI_PRIMARY_OUTPUT and leave
# LOCK_BOTTOM_OUTPUT empty.
LOCK_TOP_OUTPUT="eDP-1"
LOCK_BOTTOM_OUTPUT=""

# ── GPU power cap ─────────────────────────────────────────────────────────────
# Watts; leave empty to skip.  Only applied when desktop-nvidia profile is active.
# Find your card's TDP range: nvidia-smi -q | grep -i "power limit"
GPU_POWER_LIMIT=""

# ── USB input power fix ───────────────────────────────────────────────────────
# Set to 1 if USB keyboard/mouse don't respond during early boot (desktop only).
# Creates a udev rule to prevent USB autosuspend for input devices.
INSTALL_USB_INPUT_POWER_FIX=0

# ── GRUB ─────────────────────────────────────────────────────────────────────
# Resolution used by the GRUB menu. "auto" = firmware default.
# Find supported modes: press 'c' in GRUB, run: videoinfo
GRUB_GFXMODE="auto"
# Extra kernel cmdline args appended to the base set.
# Example (Intel IOMMU): GRUB_EXTRA_CMDLINE="intel_iommu=on iommu=pt"
# Example (AMD IOMMU):   GRUB_EXTRA_CMDLINE="amd_iommu=on iommu=pt"
GRUB_EXTRA_CMDLINE=""

# ── CPU power profile ─────────────────────────────────────────────────────────
# Only used when power-profile or desktop-nvidia profile is active.
# Governors: powersave, performance, schedutil
CPU_GOVERNOR="powersave"
# EPP (Energy Performance Preference): power, balance_power, balance_performance, performance
CPU_EPP="balance_performance"

# ── Steam paths ───────────────────────────────────────────────────────────────
# Only used when the steam profile is active.
# For Steam on a separate drive, adjust accordingly (e.g. /adata/Steam).
STEAM_DATA_DIR="$HOME/.local/share/Steam"
STEAM_LIBRARY_DIR="$HOME/.local/share/Steam/SteamLibrary"

# ── Screenshot directory ──────────────────────────────────────────────────────
SCREENSHOT_DIR="$HOME/Pictures/Screenshots"

# ── Proxy (optional) ─────────────────────────────────────────────────────────
# Runit service name in /etc/sv/; leave empty if no proxy service is configured.
# Examples: naive-proxy, v2ray, xray
PROXY_SV_NAME=""
# SOCKS5 address for the "Check IP" function in net-control.sh (host:port)
PROXY_SOCKS5="127.0.0.1:1080"

# ── AmneziaWG (optional) ──────────────────────────────────────────────────────
# Path to the AmneziaWG config used by the amnezia()/amnezia-stop() shell functions.
# Leave unset to use the default ($HOME/amnezia/awg1.conf).
# AWG_CONF="$HOME/amnezia/awg1.conf"

# ── Machine-specific notes ────────────────────────────────────────────────────
# Add any machine-specific variables below (custom paths, feature flags, etc.)
# These will be sourced by install.sh and also symlinked to ~/.config/host.env
# so scripts like net-control.sh and waybar can read them at runtime.
