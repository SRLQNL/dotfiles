# Example host config — copy to hosts/<your-hostname>/host.env and edit
#
# To find your hostname: hostname -s
# To list niri outputs: niri msg outputs
# To list GRUB modes: press 'c' in GRUB, then run: videoinfo

# Profiles to activate (space-separated, combinable)
# Available: desktop-nvidia  laptop  steam  grub-themed  power-profile
PROFILES="grub-themed power-profile"

# Monitor config
NIRI_PRIMARY_OUTPUT="eDP-1"
NIRI_SECONDARY_OUTPUT=""
NIRI_PRIMARY_MODE="1920x1080@60"
NIRI_PRIMARY_POSITION="0,0"

# Lock screen output names (same as NIRI_PRIMARY/SECONDARY_OUTPUT)
LOCK_TOP_OUTPUT="eDP-1"
LOCK_BOTTOM_OUTPUT=""

# GPU power cap in watts (leave empty to skip; only applies with desktop-nvidia profile)
GPU_POWER_LIMIT=""

# GRUB display mode (auto = firmware default)
GRUB_GFXMODE="auto"

# Steam paths (only used with steam profile)
STEAM_DATA_DIR="$HOME/.local/share/Steam"
STEAM_LIBRARY_DIR="$HOME/.local/share/Steam/SteamLibrary"

# Screenshot directory
SCREENSHOT_DIR="$HOME/Pictures/Screenshots"
