#!/bin/sh
set -eu

TOP_OUTPUT="${LOCK_TOP_OUTPUT:-DP-1}"
BOTTOM_OUTPUT="${LOCK_BOTTOM_OUTPUT:-DP-2}"
TOP_MODE="${LOCK_TOP_MODE:-1920x1080@143.80}"
BOTTOM_MODE="${LOCK_BOTTOM_MODE:-1920x1080@143.80}"
RESTORE_SCRIPT="${RESTORE_SCRIPT:-$HOME/.local/bin/restore-second-monitor-after-unlock}"
LOG_FILE="/tmp/one-screen-lock.log"

printf '%s start\n' "$(date '+%F %T')" >> "$LOG_FILE"

/usr/sbin/kscreen-doctor output."$TOP_OUTPUT".disable >/dev/null 2>&1 || true
printf '%s disabled-top\n' "$(date '+%F %T')" >> "$LOG_FILE"
sleep 1
nohup "$RESTORE_SCRIPT" >/tmp/restore-second-monitor.log 2>&1 &
printf '%s started-restore\n' "$(date '+%F %T')" >> "$LOG_FILE"
/usr/sbin/loginctl lock-session "${XDG_SESSION_ID:-self}" >/dev/null 2>&1 || /usr/sbin/qdbus org.freedesktop.ScreenSaver /ScreenSaver Lock >/dev/null 2>&1 || true
printf '%s lock-issued\n' "$(date '+%F %T')" >> "$LOG_FILE"
