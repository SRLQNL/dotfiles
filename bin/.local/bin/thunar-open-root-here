#!/bin/sh

target="$1"
[ -n "$target" ] || target="$PWD"
[ -d "$target" ] || target="$(dirname "$target")"

pkexec_bin=$(command -v pkexec) || {
  printf 'missing command: pkexec\n' >&2
  exit 1
}

thunar_bin=$(command -v thunar || command -v Thunar) || {
  printf 'missing command: thunar\n' >&2
  exit 1
}

exec "$pkexec_bin" env \
  WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-}" \
  XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-}" \
  DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-}" \
  "$thunar_bin" "$target"
