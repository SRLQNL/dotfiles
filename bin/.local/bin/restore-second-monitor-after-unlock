#!/bin/sh
set -eu

TOP_OUTPUT="DP-1"
BOTTOM_OUTPUT="DP-2"
LOG_FILE="/tmp/restore-second-monitor.log"

log() {
  printf '%s %s\n' "$(date '+%F %T')" "$*" >> "$LOG_FILE"
}

is_locked() {
  if [ -n "${XDG_SESSION_ID:-}" ]; then
    state="$(/usr/sbin/loginctl show-session "${XDG_SESSION_ID}" -p LockedHint --value 2>/dev/null | tr 'A-Z' 'a-z' || true)"
    case "$state" in
      yes|true|1)
        return 0
        ;;
      no|false|0)
        return 1
        ;;
    esac
  fi

  /usr/sbin/qdbus org.freedesktop.ScreenSaver /ScreenSaver GetActive 2>/dev/null | grep -qi true
}

log "watcher started"
sleep 2
locked_seen=0
count=0
while [ "$count" -lt 7200 ]; do
  if is_locked; then
    locked_seen=1
    log "still locked"
  else
    if [ "$locked_seen" -eq 1 ]; then
      log "unlock confirmed"
      break
    fi
    log "lock not observed yet"
  fi
  count=$((count + 1))
  sleep 1
done

sleep 1
attempt=1
while [ "$attempt" -le 10 ]; do
  if /usr/sbin/kscreen-doctor \
    output."$TOP_OUTPUT".enable \
    output."$TOP_OUTPUT".position.0,0 \
    output."$BOTTOM_OUTPUT".enable \
    output."$BOTTOM_OUTPUT".position.0,1080 \
    output."$TOP_OUTPUT".priority.2 \
    output."$BOTTOM_OUTPUT".priority.1 \
    >/dev/null 2>&1; then
    log "restore ok on attempt $attempt"
    exit 0
  fi
  log "restore failed on attempt $attempt"
  attempt=$((attempt + 1))
  sleep 1
done

log "restore gave up"
exit 0
