# NVIDIA desktop profile
# Adds NVIDIA kernel param, 32-bit libs, and power management
INSTALL_PACKAGES_FILE="${INSTALL_PACKAGES_FILE:-} $DOTFILES_DIR/packages/void-nvidia.txt"
GRUB_EXTRA_CMDLINE="${GRUB_EXTRA_CMDLINE:+${GRUB_EXTRA_CMDLINE} }nvidia-drm.modeset=1 nvidia-drm.fbdev=1"
INSTALL_POWER_PROFILE=1
INSTALL_NVIDIA_WAYLAND_ENV=1
# Conservative default — override in hosts/HOSTNAME/host.env for your specific GPU TDP
GPU_POWER_LIMIT="${GPU_POWER_LIMIT:-150}"
