# NVIDIA desktop profile
# Adds NVIDIA kernel param, 32-bit libs, and power management
INSTALL_PACKAGES_EXTRA="${INSTALL_PACKAGES_EXTRA:-} $DOTFILES_DIR/packages/void-nvidia.txt"
GRUB_EXTRA_CMDLINE="${GRUB_EXTRA_CMDLINE:-} nvidia-drm.modeset=1"
INSTALL_POWER_PROFILE="${INSTALL_POWER_PROFILE:-1}"
GPU_POWER_LIMIT="${GPU_POWER_LIMIT:-150}"
