# CPU/GPU power management profile
# Installs the power-profile runit service
INSTALL_POWER_PROFILE=1
CPU_GOVERNOR="${CPU_GOVERNOR:-powersave}"
CPU_EPP="${CPU_EPP:-balance_performance}"
# Conservative default — override in hosts/HOSTNAME/host.env for your specific GPU TDP
GPU_POWER_LIMIT="${GPU_POWER_LIMIT:-150}"
